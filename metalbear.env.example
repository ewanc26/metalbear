# MetalBear environment configuration (mirrors refpds PDS_* vars).
# Source this file (or export the METALBEAR_* vars) before running
# the `metalbear` server or the `metalbear-admin` CLI.

# --- core (required) ---
METALBEAR_PORT=2583
METALBEAR_LISTEN=127.0.0.1
# Graceful shutdown: wait up to this many seconds for in-flight writes on
# SIGTERM/SIGINT (new writes get 503 once draining). 0 stops immediately.
# Keep it below the orchestrator's stop grace period (Docker default 10s).
METALBEAR_DRAIN_TIMEOUT_SECONDS=5
METALBEAR_DATA=./data
METALBEAR_SERVICE_DID=did:web:example.com
METALBEAR_ACCOUNT_DID=did:plc:metalbear
METALBEAR_HANDLE=alice.example.com
METALBEAR_USER_DOMAIN=.example.com
METALBEAR_PASSWORD=change-me

# Public hostname used by relays/crawlers (request-crawl sends this).
METALBEAR_HOSTNAME=example.com

# Periodic repo garbage collection: seconds between passes that drop MST and
# record blocks unreachable from each account's current head commit. 0 (default)
# leaves it off; negative values are refused at startup. Active, non-taken-down
# accounts only. METALBEAR_REPO_GC_INTERVAL_SECONDS wins over config files.
# METALBEAR_REPO_GC_INTERVAL_SECONDS=86400

# --- two-factor login ---
# Where the 32-byte TOTP key lives. Defaults to totp.key in the data directory;
# keep it outside the data directory and out of backups where you can.
# METALBEAR_TOTP_KEY_FILE=./totp.key
# How long a trusted device may skip the second factor after a successful code
# login, in seconds. 0 (the default) means 30 days; negative values are refused
# at startup. Losing the key drops every trusted device, because only a keyed
# hash is stored. See docs/totp.md.
# METALBEAR_TRUSTED_DEVICE_SECONDS=2592000

# --- admin (mirrors PDS_ADMIN_PASSWORD) ---
# When set, admin endpoints (com.atproto.admin.getAccountInfo) require
# HTTP Basic `admin:<this password>`. When unset they return 401.
METALBEAR_ADMIN_PASSWORD=change-me-admin

# --- crawlers/relays (mirrors PDS_CRAWLERS) ---
# Comma-separated hostnames POSTed a com.atproto.sync.requestCrawl
# when `metalbear-admin request-crawl` runs. Empty => requestCrawl
# returns an honest NoCrawlersConfigured error.
METALBEAR_CRAWLERS=https://bsky.network

# --- single-user mode (issue #264) ---
# 1/true restricts this host to exactly one account. Off by default: with it
# off, multi-account behaviour is unchanged. The same binary is used either
# way; this is a config-gated restriction, not a separate build. Accepts
# 1/true/0/false and overrides server.single_user from the config file.
# createAccount works once for the bootstrap account, then returns 404; invite
# codes, com.atproto.admin.* and the /admin and /signup pages do too.
# scripts/setup.sh --single-user writes server.single_user and provisions that
# one account; a seeded host's conformance check uses it (docs/conformance.md).
# METALBEAR_SINGLE_USER=0

# --- invite gating (mirrors PDS_INVITE_REQUIRED) ---
# 1/true => createAccount requires a non-empty inviteCode. This is the
# fallback for per-domain admission when no domain matches. In single-user
# mode the one bootstrap createAccount bypasses admission; every later one is
# 404, so there is no invite code to mint or use.
METALBEAR_INVITE_REQUIRED=false

# --- per-domain signup admission (overrides the fallback above) ---
# default: open | invite | closed
# *_DOMAINS: comma-separated handle suffixes including the leading dot.
# Longest match wins; closed domains get 400 UnsupportedDomain. The bundled
# frontend advertises the effective mode in /operator.json and shapes /signup
# accordingly; createAccount remains authoritative.
# METALBEAR_ADMISSION_DEFAULT=invite
# METALBEAR_ADMISSION_OPEN_DOMAINS=.open.example.com
# METALBEAR_ADMISSION_INVITE_DOMAINS=.invite.example.com
# METALBEAR_ADMISSION_CLOSED_DOMAINS=.closed.example.com

# --- opt-in public instance status (issue #267) ---
# 1/true adds aggregate host/process figures to /operator.json and the landing
# page. 0/false (the default) omits the field entirely; /metrics remains the
# admin-gated fuller view. Never includes account identifiers.
# METALBEAR_PUBLIC_STATUS=false

# --- opt-in custom-domain handles ---
# 1/true accepts handles outside METALBEAR_USER_DOMAIN when `_atproto.<handle>`
# resolves to the account's DID before any PLC write. The domain owner publishes
# that record; MetalBear's DNS provider stays host-only.
# METALBEAR_ALLOW_CUSTOM_DOMAINS=false
# Comma-separated dotted suffixes restricting which custom domains are allowed;
# empty accepts any valid domain. Entries must start with '.'.
# METALBEAR_ALLOWED_CUSTOM_DOMAINS=.example.net,.example.org

# --- blob upload limit in bytes (mirrors PDS_BLOB_UPLOAD_LIMIT) ---
# Defaults to 5 MB when unset, matching the reference PDS.
# 0 => unlimited (only sensible behind your own quota).
METALBEAR_BLOB_UPLOAD_LIMIT=5242880

# --- per-account storage quotas in bytes (0 = unlimited) ---
# Defaults for accounts that have no explicit quota in their account store.
# METALBEAR_REPO_BYTES=0
# METALBEAR_BLOB_BYTES=0

# --- optional email ---
# METALBEAR_SMTP_HOST=
# METALBEAR_SMTP_PORT=587
# METALBEAR_SMTP_USERNAME=
# METALBEAR_SMTP_PASSWORD=
# METALBEAR_FROM_ADDRESS=
# METALBEAR_ACCOUNT_EMAIL=admin@example.com
