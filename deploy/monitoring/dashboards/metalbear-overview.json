{
  "uid": "metalbear-overview",
  "title": "MetalBear Overview",
  "tags": ["metalbear"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Version",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "metalbear_build_info", "legendFormat": "{{version}}" }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Uptime",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "mappings": [], "thresholds": { "mode": "absolute", "steps": [] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "metalbear_uptime_seconds", "legendFormat": "uptime" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Active accounts",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "metalbear_accounts{status=\"active\"}", "legendFormat": "active" }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Firehose sequence",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "mappings": [], "thresholds": { "mode": "absolute", "steps": [] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "colorMode": "value", "graphMode": "none", "justifyMode": "auto" },
      "description": "A stalled sequence while accounts are still writing is a PDS nobody can tell is down.",
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "metalbear_firehose_seq", "legendFormat": "seq" }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Accounts by status",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 4 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "metalbear_accounts", "legendFormat": "{{status}}" }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "XRPC request rate by route",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "sum by (route) (rate(metalbear_route_requests_total[5m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "XRPC error rate by route",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "sum by (route) (rate(metalbear_route_errors_total[5m]))", "legendFormat": "{{route}}" }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Firehose sequence growth",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 12 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "metalbear_firehose_seq", "legendFormat": "seq" }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Open account contexts",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 12 },
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "metalbear_account_cache_resident", "legendFormat": "resident" },
        { "refId": "B", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "metalbear_account_cache_idle", "legendFormat": "idle" }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Host CPU",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 12 },
      "fieldConfig": { "defaults": { "unit": "percent" }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        { "refId": "A", "datasource": { "type": "prometheus", "uid": "metalbear-prometheus" }, "expr": "100 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100", "legendFormat": "{{instance}}" }
      ]
    }
  ]
}
